# Never commit a real API key. Export this variable in your terminal or secret manager.
ODDS_API_KEY=
AIFPL_ADMIN_API_KEY=

# Optional source freshness limits used by check-source-health.
AIFPL_BOOTSTRAP_MAX_AGE_HOURS=24
AIFPL_FIXTURES_MAX_AGE_HOURS=24
AIFPL_EVENT_LIVE_MAX_AGE_HOURS=24
AIFPL_ODDS_MAX_AGE_HOURS=6
AIFPL_EVENT_MARKETS_MAX_AGE_HOURS=6
AIFPL_PLAYER_EVIDENCE_MAX_AGE_HOURS=24
AIFPL_MIN_ODDS_FIXTURE_COVERAGE=0.8

# Optional JSON object merged over built-in FPL/bookmaker team aliases.
AIFPL_TEAM_ALIASES_FILE=

# Transient HTTP failures retry with delays of base, 2*base, 4*base, etc.
AIFPL_HTTP_RETRY_ATTEMPTS=3
AIFPL_HTTP_RETRY_BASE_SECONDS=0.5

# Deadline scheduler settings.
AIFPL_SCHEDULER_LEAD_MINUTES=90
AIFPL_SCHEDULER_HORIZON_GAMEWEEKS=6
AIFPL_SCHEDULER_POLL_SECONDS=300
AIFPL_SCHEDULER_BUDGET=1000
AIFPL_HORIZON_SOLVER_MAX_SECONDS=60

# Optional structured JSON evidence sources. Records must use exact FPL player IDs.
AIFPL_PLAYER_EVIDENCE_FILE=
AIFPL_PLAYER_EVIDENCE_URLS=
AIFPL_EVIDENCE_BEARER_TOKEN=
AIFPL_EVIDENCE_MAX_AGE_HOURS=168

# Event markets cost quota per event and market; disabled in automatic refresh by default.
AIFPL_FETCH_EVENT_MARKETS=false
AIFPL_PLAYER_PROP_WEIGHT=0

# Hermes uses any OpenAI-compatible chat-completions endpoint.
HERMES_BASE_URL=https://api.deepseek.com
HERMES_MODEL=deepseek-v4-flash
HERMES_API_KEY=
HERMES_MAX_TOOL_STEPS=8
HERMES_TIMEOUT_SECONDS=120
AIFPL_HERMES_AUTO_RUN=false

# Telegram deadline notifications: squad, transfers, captain, and chip advice.
# Create a bot with @BotFather and set the chat to your user or group.
AIFPL_TELEGRAM_BOT_TOKEN=
AIFPL_TELEGRAM_CHAT_ID=
AIFPL_TELEGRAM_ENABLED=false
AIFPL_TELEGRAM_NOTIFY_LEAD_MINUTES=240
