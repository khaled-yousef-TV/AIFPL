# Never commit a real API key. Export this variable in your terminal or secret manager.
ODDS_API_KEY=
AIFPL_ADMIN_API_KEY=
AIFPL_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional source freshness limits used by check-source-health.
AIFPL_BOOTSTRAP_MAX_AGE_HOURS=24
AIFPL_FIXTURES_MAX_AGE_HOURS=24
AIFPL_EVENT_LIVE_MAX_AGE_HOURS=24
AIFPL_ODDS_MAX_AGE_HOURS=6
AIFPL_EVENT_MARKETS_MAX_AGE_HOURS=6
AIFPL_PLAYER_EVIDENCE_MAX_AGE_HOURS=24
AIFPL_MIN_ODDS_FIXTURE_COVERAGE=0.8

# Optional JSON object merged over built-in FPL/bookmaker team aliases.
AIFPL_TEAM_ALIASES_FILE=

# Transient HTTP failures retry with delays of base, 2*base, 4*base, etc.
AIFPL_HTTP_RETRY_ATTEMPTS=3
AIFPL_HTTP_RETRY_BASE_SECONDS=0.5

# Deadline scheduler settings.
# Release is relative to each gameweek's official FPL deadline: this many minutes
# before kickoff the audited refresh and decision run, so late team news is
# captured every week regardless of kickoff time. Setting
# AIFPL_SCHEDULER_RELEASE_TIME overrides that with a fixed HH:MM release on the
# deadline date (falling back to the lead offset for earlier deadlines).
AIFPL_SCHEDULER_RELEASE_TIME=
AIFPL_SCHEDULER_TIMEZONE=Europe/London
AIFPL_SCHEDULER_LEAD_MINUTES=150
AIFPL_SCHEDULER_HORIZON_GAMEWEEKS=6
AIFPL_SCHEDULER_POLL_SECONDS=300
AIFPL_SCHEDULER_BUDGET=1000
AIFPL_HORIZON_SOLVER_MAX_SECONDS=60

# Live odds-projection calibration stays unchanged until enough completed
# gameweeks have accumulated, then applies a capped recency-weighted correction.
AIFPL_LIVE_CALIBRATION_WINDOW_GAMEWEEKS=8
AIFPL_LIVE_CALIBRATION_MIN_GAMEWEEKS=4
AIFPL_LIVE_CALIBRATION_MIN_OBSERVATIONS=1000
AIFPL_LIVE_CALIBRATION_RECENCY_DECAY=0.85

# Read-only chip advisor. Two sets of every chip per season (set 1 expires at
# the set1-end gameweek, set 2 opens after). Intel scrapes the official FPL
# rules page and r/FantasyPL for rules changes and expected double/blank
# gameweeks; it is evidence only, never auto-spent.
AIFPL_CHIP_SET1_END_GW=19
AIFPL_CHIP_WILDCARD_POINTS_GAP=20
AIFPL_CHIP_BENCH_BOOST_BENCH_POINTS=24
AIFPL_CHIP_TC_CAPTAIN_POINTS=13
AIFPL_CHIP_TC_MARGIN=3
AIFPL_CHIP_FH_STARTERS_WITHOUT_FIXTURE=3
AIFPL_CHIP_INTEL_ENABLED=true
AIFPL_CHIP_INTEL_CACHE_HOURS=6
AIFPL_CHIP_INTEL_MAX_TIMING=12
AIFPL_CHIP_REDDIT_LIMIT=10
AIFPL_CHIP_RULES_URL=https://www.premierleague.com/en/news/4679879/whats-happening-with-fpl-chips-in-202627

# Horizon optimizer soft objectives (projected-point penalties).
AIFPL_TRANSFER_PENALTY=1.0

# Squad robustness soft constraints. Bench floor applies to bench players only.
AIFPL_MIN_BANK_TENTHS=50
AIFPL_BENCH_MIN_PROJECTION=2.0
AIFPL_BENCH_WEIGHT=0.25
AIFPL_BANK_SHORTFALL_PENALTY=0.5
AIFPL_DEAD_BENCH_PENALTY=2.0

# Optional structured JSON evidence sources. Records must use exact FPL player IDs.
AIFPL_PLAYER_EVIDENCE_FILE=
AIFPL_PLAYER_EVIDENCE_URLS=
AIFPL_EVIDENCE_BEARER_TOKEN=
AIFPL_EVIDENCE_MAX_AGE_HOURS=168

# Tavily discovers recent player news for owned players and bounded transfer-in candidates.
TAVILY_API_KEY=
AIFPL_TAVILY_ENABLED=false
AIFPL_TAVILY_MAX_RESULTS=10
AIFPL_TAVILY_CACHE_HOURS=6
AIFPL_TAVILY_MAX_CANDIDATE_PLAYERS=5
AIFPL_TAVILY_START_PROBABILITY_THRESHOLD=0.7

# Event markets cost quota per event and market; disabled in automatic refresh by default.
AIFPL_FETCH_EVENT_MARKETS=false
AIFPL_PLAYER_PROP_WEIGHT=0

# Hermes uses any OpenAI-compatible chat-completions endpoint.
HERMES_BASE_URL=https://api.deepseek.com
HERMES_MODEL=deepseek-v4-flash
HERMES_API_KEY=
HERMES_MAX_TOOL_STEPS=8
HERMES_TIMEOUT_SECONDS=120
AIFPL_HERMES_AUTO_RUN=false

# Telegram deadline notifications: squad, transfers, captain, and chip advice.
# Create a bot with @BotFather and set the chat to your user or group.
AIFPL_TELEGRAM_BOT_TOKEN=
AIFPL_TELEGRAM_CHAT_ID=
AIFPL_TELEGRAM_ENABLED=false
AIFPL_TELEGRAM_NOTIFY_LEAD_MINUTES=240
